{
  "name": "npm-runner",
  "private": true,
  "version": "1.3.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint **/*.{js,jsx}",
    "lint:fix": "eslint --fix **/*.{js,jsx}",
    "stylelint": "stylelint '**/*.{css,scss}'",
    "stylelint:fix": "stylelint --fix '**/*.{css,scss}'",
    "test": "vitest run",
